# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. This file (.env.example) IS committed and should
# be kept in sync whenever a new env var is introduced.

NODE_ENV=development
PORT=3000

# Externally-reachable base URL of this API — used to build links embedded
# in emails (verification, password reset). Update for staging/production.
APP_BASE_URL="http://localhost:3000"

# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/workout_tracker"

# JWT secrets — generate strong random values locally, e.g.:
#   openssl rand -base64 48
# Minimum 32 characters enforced by env validation (see src/config/env.validation.ts)
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth — from Google Cloud Console credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Comma-separated origins allowed for CORS, or "*" for local dev
CORS_ORIGIN="*"

# Global rate-limit defaults. Auth's sensitive endpoints (signup, login,
# etc.) use a stricter, hardcoded limit directly in code — not env-tunable.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
